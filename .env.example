# Copy to .env, then change the values. Never commit .env.

# Database (docker-compose)
POSTGRES_USER=outagemap
POSTGRES_PASSWORD=outagemap
POSTGRES_DB=outagemap

# Backend
PORT=8080
DATABASE_URL=postgres://outagemap:outagemap@localhost:5432/outagemap?sslmode=disable
TEST_DATABASE_URL=postgres://outagemap:outagemap@localhost:5432/outagemap_test?sslmode=disable
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false
APP_TIMEZONE=Asia/Colombo

# Frontend
VITE_API_URL=http://localhost:8080
